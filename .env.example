# このファイルは値を書かない。キー名だけを示す。
# 実際の値は Vercel のダッシュボードが正本（docs/IMPLEMENTATION_PLAN.md §10.3）。
# ローカル開発では .env.local にコピーして値を入れる（.env.local は .gitignore 済み）。

# --- Turso (libSQL) ---
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Better Auth ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- ログイン制限（決定 D-07）。カンマ区切りで複数ドメイン可 ---
ALLOWED_EMAIL_DOMAINS=

# --- ゴミ箱の定期削除エンドポイント（/api/cron/purge-trash）の認証 ---
CRON_SECRET=

# --- 絶対 URL が必要な箇所で使用 ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
