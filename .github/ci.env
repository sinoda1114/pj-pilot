# CI専用の環境変数（非シークレット）。標準CI（sinoda1114/ci-standard）が自動で読み込む。
#
# Better Auth（決定D-04）は起動時に BETTER_AUTH_SECRET 等の設定を要求する。
# ここの値はCI専用のダミー（実Google OAuthはe2eでは使わず、better-auth/plugins の
# testUtils でセッションを直接発行するため、CLIENT_ID/SECRET の値自体は使われない）。
BETTER_AUTH_SECRET=ci-only-dummy-secret-not-for-production-use-1234567890
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=ci-dummy-client-id
GOOGLE_CLIENT_SECRET=ci-dummy-client-secret
ALLOWED_EMAIL_DOMAINS=example.com
